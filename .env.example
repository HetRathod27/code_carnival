# QueueLess Environment Variables

# Application Environment
ENVIRONMENT=development

# Database Configuration (PostgreSQL 13+)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/queueless_dev

# Test Database Configuration
# CRITICAL SAFETY RULE: The database name MUST end with '_test' (e.g., queueless_test)
# Any test, truncation, drop, or migration reset will strictly refuse to run if the DB name does not end in '_test'.
TEST_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/queueless_test

# Internal Service Shared Secret (for /internal/tick)
INTERNAL_TICK_SECRET=change_me_to_a_secure_random_string

# Timezone Default
DEFAULT_TIMEZONE=Asia/Kolkata
